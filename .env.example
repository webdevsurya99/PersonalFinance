# Application Settings
APP_NAME="FinMinimal - Personal Finance"
APP_ENV="production"
DEBUG=False
PORT=8000
HOST="0.0.0.0"

# Security & Secrets (Must be set to strong random values in production)
SECRET_KEY="replace-with-a-very-strong-random-secret-key-in-production"
CSRF_SECRET_KEY="replace-with-another-strong-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200  # 30 days

# Cookie Security (Set SECURE_COOKIES=True when running behind HTTPS/SSL)
SECURE_COOKIES=False
SESSION_COOKIE_NAME="fin_session_token"

# Database Configuration (Supports SQLite, PostgreSQL, MySQL)
DATABASE_URL="sqlite:///./finance.db"

# Admin Defaults (Created automatically if no admin exists)
ADMIN_DEFAULT_EMAIL="admin@finminimal.local"
ADMIN_DEFAULT_PASSWORD="ChangeMe123!Secure"
ADMIN_DEFAULT_NAME="System Admin"

# Rate Limiting
RATE_LIMIT_LOGIN="5/minute"
RATE_LIMIT_GENERAL="100/minute"

# Currency
DEFAULT_CURRENCY_SYMBOL="₹"
DEFAULT_CURRENCY_CODE="INR"
